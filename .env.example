# Backend only. Never expose these values to the browser.
# For Render production deploy, use NODE_ENV=production.
NODE_ENV=production
PORT=3000
# Optional on Render: it automatically provides RENDER_EXTERNAL_URL.
# Set APP_URL only when using a custom domain or a separate frontend URL.
APP_URL=
# API base used by the frontend when it is hosted separately from the API.
# Leave empty when frontend and API share the same public origin.
FIXFLOW_API_URL=
# When set, billing and account data persist in PostgreSQL. Without it, the API uses in-memory storage.
DATABASE_URL=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
# Optional until checkout/webhooks are enabled in Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
BILLING_GRACE_PERIOD_DAYS=3
# Optional allowlist for one lifetime Business entitlement. Never hardcode this email.
LIFETIME_BUSINESS_EMAIL=
# Required in production; use a randomly generated value with at least 32 characters.
SESSION_SECRET=
